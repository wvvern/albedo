{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Flatten blocks, sky, fluids and more to a single color or texture so moving things stand out.",
  "authors": [],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.plainview.fabric.PlainviewFabric"],
    "modmenu": ["dev.plainview.fabric.ModMenuIntegration"]
  },
  "mixins": ["plainview.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  }
}

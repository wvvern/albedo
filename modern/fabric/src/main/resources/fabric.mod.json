{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Changes blocks, sky, fluids, mobs and more to one flat color, the average color of each texture, or a PNG. Things that move are easy to see.",
  "authors": [],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.blockpainter.fabric.BlockPainterFabric"],
    "modmenu": ["dev.blockpainter.fabric.ModMenuIntegration"]
  },
  "mixins": ["blockpainter.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  }
}

{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Paint blocks, fluids, the sky, mobs and the rest of the world in any color. Give each part one flat color, or recolor its textures and keep their detail.",
  "authors": [],
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.albedo.fabric.AlbedoFabric"],
    "modmenu": ["dev.albedo.fabric.ModMenuIntegration"]
  },
  "mixins": ["albedo.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  }
}
